# Postgres connection string (Neon or Supabase). Get from your provider's dashboard.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Optional: EPA Envirofacts UV API base (no key required, listed for clarity/override in tests)
EPA_UV_API_BASE="https://data.epa.gov/efservice"

# Optional: Open-Meteo base URLs (no key required). Overridable for testing against a mock.
OPEN_METEO_FORECAST_BASE="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_HISTORICAL_BASE="https://archive-api.open-meteo.com/v1/archive"
